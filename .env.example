# Use the pooled Neon connection for normal application queries.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Use the direct/unpooled connection for Drizzle migrations.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Secret used by the ChatGPT/GPT Actions connector routes under /api/ai.
AI_CONNECTOR_API_KEY=replace-with-a-long-random-secret
